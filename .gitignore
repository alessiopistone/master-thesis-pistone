# Python (cache and virtual environments)
__pycache__/
*.py[cod]
.venv/
env/

# Data & Output (avoiding pushing heavy datasets)
data/generated/*
!data/generated/.gitkeep
results/*
!results/.gitkeep

# LaTeX (temporary files generated by TeXStudio / MiKTeX)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.pdf

# Windows system files
Thumbs.db
Desktop.ini

# Spyder IDE configuration
.spyproject/
.spyderproject/